{
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "mcp": {
      "injectIntoAgents": true
    },
    "browserTools": {
      "enabled": false
    },
    "autoArchiveAfterMerge": false,
    "enableTerminalAgentHooks": false,
    "appendSystemPrompt": "Use Paseo for subagent work. Choose models and thinking from `list_profiles`. Use completion notifications instead of polling. Verify delegated results. For dependent work, keep the current turn active with a blocking `paseo wait <agent-id>`; completion notifications are one-shot wakeups, not persistent subscriptions.",
    "terminalProfiles": [
      {
        "id": "claude",
        "name": "Claude Code",
        "command": "claude",
        "icon": "claude"
      },
      {
        "id": "codex",
        "name": "Codex",
        "command": "codex",
        "icon": "codex"
      }
    ],
    "agentProfiles": [
      {
        "id": "owner",
        "name": "Owner / planner",
        "provider": "claude",
        "model": "claude-fable-5-1",
        "thinkingOptionId": "medium",
        "notes": "Default owner and planner for substantial work; coordinate and integrate delegated results.",
        "modeId": "bypassPermissions"
      },
      {
        "id": "implementer",
        "name": "Implementer",
        "provider": "claude",
        "model": "claude-sonnet-5",
        "thinkingOptionId": "high",
        "notes": "Bounded implementation with clear scope and acceptance criteria.",
        "modeId": "bypassPermissions"
      },
      {
        "id": "scout",
        "name": "Scout / small tasks",
        "provider": "codex",
        "model": "gpt-5.6-luna",
        "thinkingOptionId": "low",
        "notes": "Bounded research, navigation, and small predictable tasks; escalate uncertainty.",
        "modeId": "full-access"
      },
      {
        "id": "deep-technical",
        "name": "Deep technical work",
        "provider": "codex",
        "model": "gpt-6-astra",
        "thinkingOptionId": "high",
        "notes": "Difficult debugging, architecture, and technical reasoning.",
        "modeId": "full-access"
      },
      {
        "id": "design-vision",
        "name": "Design / vision",
        "provider": "codex",
        "model": "gpt-6-astra",
        "thinkingOptionId": "high",
        "notes": "Visual analysis, UI design, and image-heavy work.",
        "modeId": "full-access"
      },
      {
        "id": "review-openai",
